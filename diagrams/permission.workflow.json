{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Tool Permission Decision Pipeline (Claude Code four layers + DSH guard)",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "diagrams/permission.workflow.html"
  },
  "lanes": [
    {
      "id": "call",
      "label": "Tool Calls"
    },
    {
      "id": "policy",
      "label": "Decision Layers",
      "variant": "exception"
    },
    {
      "id": "result",
      "label": "Outcome"
    }
  ],
  "phases": [
    {
      "id": "static",
      "label": "Static Rules",
      "fromCol": 0,
      "toCol": 2,
      "variant": "emphasis"
    },
    {
      "id": "dynamic",
      "label": "Model Adjudication",
      "fromCol": 3,
      "toCol": 4
    },
    {
      "id": "execute",
      "label": "Execute",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "call",
    "rules",
    "acceptEdits",
    "readonly",
    "classifier",
    "exec"
  ],
  "nodes": [
    {
      "id": "call",
      "lane": "call",
      "col": 0,
      "type": "external",
      "label": "Tool call",
      "sublabel": "Bash / Edit / Web",
      "width": 140
    },
    {
      "id": "rules",
      "lane": "policy",
      "col": 1,
      "type": "security",
      "label": "① Permission rules",
      "sublabel": "deny → ask → allow",
      "width": 150
    },
    {
      "id": "acceptEdits",
      "lane": "policy",
      "col": 2,
      "type": "security",
      "label": "② acceptEdits",
      "sublabel": "In-project write edits",
      "width": 150
    },
    {
      "id": "readonly",
      "lane": "policy",
      "col": 3,
      "type": "security",
      "label": "③ Read-only whitelist",
      "sublabel": "Safe tools pass directly",
      "width": 150
    },
    {
      "id": "classifier",
      "lane": "policy",
      "col": 4,
      "type": "messagebus",
      "label": "④ ML classifier",
      "sublabel": "Sonnet 4.6 transcript review",
      "tag": "AutoMode",
      "width": 150
    },
    {
      "id": "ask",
      "lane": "policy",
      "col": 5,
      "type": "frontend",
      "label": "Ask user",
      "sublabel": "Edge-case confirmation",
      "width": 120
    },
    {
      "id": "exec",
      "lane": "result",
      "col": 5,
      "type": "cloud",
      "label": "Allow & execute",
      "sublabel": "Runs in sandbox",
      "width": 150
    }
  ],
  "edges": [
    {
      "id": "call-rules",
      "from": "call",
      "to": "rules",
      "label": "Enter decision",
      "variant": "default"
    },
    {
      "id": "rules-ae",
      "from": "rules",
      "to": "acceptEdits",
      "label": "No match",
      "variant": "default"
    },
    {
      "id": "ae-ro",
      "from": "acceptEdits",
      "to": "readonly",
      "label": "Not applicable",
      "variant": "default"
    },
    {
      "id": "ae-allow",
      "from": "acceptEdits",
      "to": "exec",
      "label": "Edits allowed",
      "variant": "emphasis"
    },
    {
      "id": "ro-clf",
      "from": "readonly",
      "to": "classifier",
      "label": "No match",
      "variant": "default"
    },
    {
      "id": "ro-allow",
      "from": "readonly",
      "to": "exec",
      "label": "Read-only pass",
      "variant": "emphasis"
    },
    {
      "id": "clf-allow",
      "from": "classifier",
      "to": "exec",
      "label": "Judged safe",
      "variant": "emphasis"
    },
    {
      "id": "clf-ask",
      "from": "classifier",
      "to": "ask",
      "label": "Edge case",
      "variant": "security"
    },
    {
      "id": "ask-allow",
      "from": "ask",
      "to": "exec",
      "label": "User approves",
      "variant": "dashed",
      "role": "branch"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Four-layer decision principles",
      "items": [
        "Call the classifier only when the first three layers cannot decide (saves compute)",
        "fail-closed: no rule match defaults to ask — never default to allow"
      ]
    },
    {
      "dot": "rose",
      "title": "Contrast: DSH monotonic guard",
      "items": [
        "A deny match blocks immediately — the static rule layer stops it before later layers",
        "DSH ToolGuard only holds deny — a rejection can never be flipped to allow"
      ]
    }
  ]
}
