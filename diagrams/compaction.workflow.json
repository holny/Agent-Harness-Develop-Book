  "edges": [
    {
      "id": "start-check",
      "from": "start",
      "to": "check",
      "label": "Enter each turn",
      "variant": "default"
    },
    {
      "id": "check-pre",
      "from": "check",
      "to": "pre",
      "label": "Threshold reached",
      "variant": "emphasis"
    },
    {
      "id": "check-overflow",
      "from": "check",
      "to": "overflow",
      "label": "Provider overflow",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "overflow-summary",
      "from": "overflow",
      "to": "summary",
      "label": "Retry after compaction",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "pre-summary",
      "from": "pre",
      "to": "summary",
      "label": "Preserve fine-grained context",
      "variant": "default"
    },
    {
      "id": "summary-cut",
      "from": "summary",
      "to": "cut",
      "label": "Fix cut point",
      "variant": "dashed"
    },
    {
      "id": "cut-rebuild",
      "from": "cut",
      "to": "rebuild",
      "label": "Apply cut point",
      "variant": "dashed"
    },
    {
      "id": "rebuild-resume",
      "from": "rebuild",
      "to": "resume",
      "label": "New context",
      "variant": "emphasis"
    },
    {
      "id": "resume-final",
      "from": "resume",
      "to": "final",
      "label": "Continue turn",
      "variant": "default"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Cut-point discipline",
      "items": [
        "Never cut at a toolResult — keep tool_use / tool_result pairs intact",
        "Recent dialogue kept verbatim: OpenCode takes usable×50% (cap 32K)"
      ]
    },
    {
      "dot": "rose",
      "title": "Trigger thresholds across the six projects",
      "items": [
        "Claude Code window−13K · Codex window×90% dual scope · Pi window−16384",
        "OpenCode count≥usable · DSH pressure+overflow dual trigger · Hermes input budget×50%"
      ]
    }
  ]
}
