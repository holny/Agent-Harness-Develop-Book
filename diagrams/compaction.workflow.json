{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Context Compaction Decision Pipeline",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "diagrams/compaction.workflow.html"
  },
  "lanes": [
    {
      "id": "ui",
      "label": "Session"
    },
    {
      "id": "agent",
      "label": "Compaction"
    },
    {
      "id": "control",
      "label": "Triggers & Rules",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "monitor",
      "label": "Monitor",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "compact",
      "label": "Compact",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "rebuild",
      "label": "Rebuild",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "start",
    "check",
    "pre",
    "summary",
    "cut",
    "rebuild",
    "resume",
    "final"
  ],
  "nodes": [
    {
      "id": "start",
      "lane": "ui",
      "col": 0,
      "type": "external",
      "label": "Per-turn request",
      "width": 140
    },
    {
      "id": "check",
      "lane": "control",
      "col": 1,
      "type": "security",
      "label": "Threshold check",
      "sublabel": "window−13K / 90% / usable",
      "tag": "Thresholds vary across the six projects",
      "width": 150
    },
    {
      "id": "pre",
      "lane": "agent",
      "col": 2,
      "type": "backend",
      "label": "Pre-compaction",
      "sublabel": "contextCollapse · memory flush",
      "width": 170
    },
    {
      "id": "overflow",
      "lane": "control",
      "col": 2,
      "type": "security",
      "label": "Reactive recovery",
      "sublabel": "ContextOverflowError",
      "width": 140
    },
    {
      "id": "summary",
      "lane": "agent",
      "col": 3,
      "type": "backend",
      "label": "Summary generation",
      "sublabel": "fork subagent · templates",
      "width": 150
    },
    {
      "id": "cut",
      "lane": "control",
      "col": 3,
      "type": "database",
      "label": "Cut-point selection",
      "sublabel": "Never cut at a toolResult",
      "width": 150
    },
    {
      "id": "rebuild",
      "lane": "agent",
      "col": 4,
      "type": "backend",
      "label": "Rebuild context",
      "sublabel": "Summary + recent verbatim",
      "width": 160
    },
    {
      "id": "resume",
      "lane": "agent",
      "col": 5,
      "type": "backend",
      "label": "Resend after compaction",
      "sublabel": "Lite mode: summary only",
      "width": 172
    },
    {
      "id": "final",
      "lane": "ui",
      "col": 5,
      "type": "frontend",
      "label": "Resume execution",
      "width": 140
    }
