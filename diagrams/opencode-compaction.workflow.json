{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "OpenCode Compaction End-to-End",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "diagrams/opencode-compaction.workflow.html"
  },
  "lanes": [
    {
      "id": "trigger",
      "label": "Triggers"
    },
    {
      "id": "threshold",
      "label": "Threshold Check",
      "variant": "exception"
    },
    {
      "id": "compact",
      "label": "Compaction"
    },
    {
      "id": "output",
      "label": "Rebuilt Output"
    }
  ],
  "phases": [
    {
      "id": "detect",
      "label": "Detect",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "judge",
      "label": "Judge",
      "fromCol": 2,
      "toCol": 2,
      "variant": "emphasis"
    },
    {
      "id": "rebuild",
      "label": "Compact & Rebuild",
      "fromCol": 3,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "finishStep",
    "threshold",
    "summarize",
    "rebuild",
    "resend"
  ],
  "nodes": [
    {
      "id": "finishStep",
      "lane": "trigger",
      "col": 0,
      "type": "external",
      "label": "finish-step",
      "sublabel": "End of each LLM step stream",
      "width": 128
    },
    {
      "id": "providerError",
      "lane": "trigger",
      "col": 1,
      "type": "security",
      "label": "Provider overflow",
      "sublabel": "19 regexes / HTTP 413",
      "width": 128,
      "yOffset": 0
    },
    {
      "id": "threshold",
      "lane": "threshold",
      "col": 2,
      "type": "security",
      "label": "count ≥ usable ?",
      "sublabel": "usable = input − reserved",
      "tag": "e.g. 118K − 36K = 82K",
      "width": 165
    },
    {
      "id": "summarize",
      "lane": "compact",
      "col": 3,
      "type": "backend",
      "label": "Generate summary",
      "sublabel": "Strip media · cap 2000 · no tools",
      "width": 165
    },
    {
      "id": "rebuild",
      "lane": "compact",
      "col": 4,
      "type": "backend",
      "label": "Rebuild context",
      "sublabel": "summary 2K + verbatim 41K ≈ 43K",
      "tag": "verbatim = usable × 50%",
      "width": 170
    },
    {
      "id": "resend",
      "lane": "output",
      "col": 5,
      "type": "frontend",
      "label": "Resend",
      "sublabel": "Watermark reset",
      "width": 122
    },
    {
      "id": "splitTurn",
      "lane": "compact",
      "col": 5,
      "type": "security",
      "label": "Fallback",
      "sublabel": "splitTurn / summary-only",
      "width": 158
    }
  ],
  "edges": [
    {
      "id": "fs-th",
      "from": "finishStep",
      "to": "threshold",
      "label": "count = input+output+cache",
      "variant": "emphasis"
    },
    {
      "id": "pe-th",
      "from": "providerError",
      "to": "threshold",
      "label": "ContextOverflowError",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "th-sum",
      "from": "threshold",
      "to": "summarize",
      "label": "Triggered",
      "variant": "emphasis"
    },
    {
      "id": "sum-re",
      "from": "summarize",
      "to": "rebuild",
      "label": "Summarize pre-tail history only",
      "variant": "default"
    },
    {
      "id": "re-res",
      "from": "rebuild",
      "to": "resend",
      "label": "Append new messages",
      "variant": "emphasis"
    },
    {
      "id": "re-split",
      "from": "rebuild",
      "to": "splitTurn",
      "label": "Still overflows",
      "variant": "security",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Two threshold rules",
      "items": [
        "input sets the ceiling — input is the provider's real rejection line for the prompt",
        "reserved sets the lead — room for post-check growth Δ (tool results / new user messages), default min(20K, maxOutput)"
      ]
    },
    {
      "dot": "rose",
      "title": "Fallback & termination",
      "items": [
        "Fallback branch: input unset → usable = context − maxOutputTokens (reserved not involved)",
        "If compaction itself overflows → MAX_AUTO_COMPACT ends the conversation, no loop",
        "finish_reason=length is an output-truncation warning, unrelated to compaction"
      ]
    }
  ]
}
