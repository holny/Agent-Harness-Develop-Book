{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Agent Loop Main Pipeline",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "diagrams/agent-loop.workflow.html"
  },
  "lanes": [
    { "id": "ui", "label": "Session Entry" },
    { "id": "agent", "label": "Agent Runtime" },
    { "id": "control", "label": "Loop Control & Recovery", "variant": "exception" },
    { "id": "tools", "label": "Tool Execution" }
  ],
  "phases": [
    { "id": "intake", "label": "Intake", "fromCol": 0, "toCol": 1 },
    { "id": "reasoning", "label": "Reasoning & Routing", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "execute", "label": "Execute & Inject", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["user", "assemble", "llm", "parse", "gate", "exec", "inject", "final"],
  "nodes": [
    { "id": "user", "lane": "ui", "col": 0, "type": "external", "label": "User message", "sublabel": "Task input", "width": 132 },
    { "id": "assemble", "lane": "agent", "col": 1, "type": "backend", "label": "Assemble context", "sublabel": "System prompt · memory · history", "width": 150 },
    { "id": "llm", "lane": "agent", "col": 2, "type": "backend", "label": "LLM inference", "sublabel": "streamText: act while generating", "tag": "Reassembled every turn", "width": 150 },
    { "id": "parse", "lane": "agent", "col": 3, "type": "backend", "label": "Parse response", "sublabel": "text / tool_use", "width": 132 },
    { "id": "gate", "lane": "control", "col": 3, "type": "security", "label": "Loop guard", "sublabel": "permissions · doom_loop", "tag": "Triggers after 3 identical calls", "width": 150 },
    { "id": "exec", "lane": "tools", "col": 4, "type": "messagebus", "label": "Parallel tools", "sublabel": "Overlap in safe groups", "width": 150 },
    { "id": "inject", "lane": "agent", "col": 5, "type": "backend", "label": "Inject results", "sublabel": "tool_result", "width": 132 },
    { "id": "compact", "lane": "control", "col": 2, "type": "database", "label": "Context compaction", "sublabel": "Threshold · overflow recovery", "width": 150 },
    { "id": "final", "lane": "ui", "col": 5, "type": "frontend", "label": "Final reply", "sublabel": "Terminates when no tool_use", "width": 132 }
  ],
  "edges": [
    { "id": "user-assemble", "from": "user", "to": "assemble", "variant": "default" },
    { "id": "assemble-llm", "from": "assemble", "to": "llm", "label": "Assemble prompt", "variant": "emphasis" },
    { "id": "llm-parse", "from": "llm", "to": "parse", "label": "Aggregate deltas", "variant": "default" },
    { "id": "parse-gate", "from": "parse", "to": "gate", "label": "Tool call", "variant": "security" },
    { "id": "gate-exec", "from": "gate", "to": "exec", "label": "allow", "variant": "emphasis" },
    { "id": "exec-inject", "from": "exec", "to": "inject", "label": "Structured results", "variant": "default" },
    { "id": "inject-assemble", "from": "inject", "to": "assemble", "label": "Continue loop", "variant": "dashed", "role": "return", "width": 1.2 },
    { "id": "inject-final", "from": "inject", "to": "final", "label": "Task complete", "variant": "emphasis" },
    { "id": "llm-compact", "from": "llm", "to": "compact", "label": "Context overflow", "variant": "security", "role": "error" },
    { "id": "compact-assemble", "from": "compact", "to": "assemble", "label": "Compact & resend", "variant": "dashed", "role": "branch" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Loop invariants",
      "items": [
        "tool_use and tool_result strictly paired — never truncate at a tool result",
        "Context reassembled every turn: summary + recent dialogue verbatim + new messages"
      ]
    },
    {
      "dot": "rose",
      "title": "Loop exit & recovery",
      "items": [
        "Normal termination: no tool_use / step limit reached / user interrupt",
        "doom_loop: a permission denial breaks the cycle; overflow goes through compaction and resend"
      ]
    }
  ]
}
